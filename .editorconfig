# 此文件是项目的编辑器格式约定。
root = true

# 默认文本文件使用 UTF-8、LF 和四个空格缩进。
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML 的层级使用两个空格。
[*.yml]
indent_size = 2

# 批处理必须使用 Windows 换行；内容仍保持 ASCII。
[*.cmd]
end_of_line = crlf

# Markdown 中允许用行末空格表达换行。
[*.md]
trim_trailing_whitespace = false
